{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 120,
      "includeFiles": "server/**,shared/**"
    },
    "api/debug.ts": {
      "includeFiles": "server/**,shared/**"
    }
  }
}
